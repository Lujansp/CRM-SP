PORT=3000
JWT_SECRET=cambiar-esto
JWT_EXPIRES_IN=8h

# Cuenta tecnica (usada como "proxy" y para consultas generales)
ORACLE_USER=anamnesis
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=host:1521/servicio

# password : el login valida usuario/clave Oracle del empleado (no requiere cambios en la BD)
# proxy    : tras el login, cada request abre sesion "como" el empleado
#            (requiere: ALTER USER <empleado> GRANT CONNECT THROUGH anamnesis)
AUTH_MODE=password
